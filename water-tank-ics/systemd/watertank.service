[Unit]
Description=Water Tank ICS Controller (sensor + pumps + Modbus TCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/paths to your install. Port 502 needs root; if you move the
# Modbus port above 1024 in config.yaml you can run as the 'pi' user instead.
User=root
WorkingDirectory=/home/pi/water-tank-ics
ExecStart=/usr/bin/python3 -m src.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
