[Unit]
Description=Water Tank ICS Controller (sensor + pumps + Modbus TCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Port 502 needs root. If you move the Modbus port above 1024 in config.yaml
# you can run as the 'pi4' user instead. Adjust the path if your checkout
# lives somewhere other than /home/pi4/water-tank-ics.
User=root
WorkingDirectory=/home/pi4/water-tank-ics
ExecStart=/usr/bin/python3 -m src.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
